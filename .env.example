# --- DataHub ---
# GMS endpoint from Quickstart (default localhost:8080). UI is at localhost:9002.
DATAHUB_GMS_URL=http://localhost:8080
# Personal Access Token: DataHub UI → Settings → Access Tokens → Generate.
# Requires metadata_service_authentication enabled (default in recent Quickstart).
DATAHUB_GMS_TOKEN=

# --- MCP server ---
# uvx mcp-server-datahub@latest reads the two vars above.
# Enable write-back tools (v0.5.0+):
TOOLS_IS_MUTATION_ENABLED=true

# --- LLM provider (one-line swap; Ollama primary, Anthropic = filming insurance) ---
LLM_PROVIDER=ollama            # ollama | anthropic
LLM_MODEL=qwen3.6              # ollama model tag, or e.g. claude-sonnet-5 for anthropic
# ANTHROPIC_API_KEY=            # only needed when LLM_PROVIDER=anthropic
OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings ---
EMBED_MODEL=all-MiniLM-L6-v2   # sentence-transformers, local/on-device

# --- Retrieval ---
VECTOR_STORE_PATH=retrieval/patterns.db   # sqlite-vec single-file store
